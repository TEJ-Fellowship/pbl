### Variables
@baseUrl = http://localhost:5000
@cookie = connect.sid=<YOUR_COOKIE_HERE>

### Unauthenticated create event (expect 401)
POST {{baseUrl}}/api/events
Content-Type: application/json

{
  "title": "Test event",
  "start": "2026-02-28T09:00:00.000Z",
  "end": "2026-02-28T10:00:00.000Z",
  "description": "Testing create event",

  "location": "Online",
  "isAllDay": false,
  "color": "#2196F3"
}

### Authenticated create event (expect 201)
// @no-cookie-jar
POST {{baseUrl}}/api/events
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "Testing 02",
  "start": "2026-03-12T06:55:00.000Z",
  "end": "2026-03-14T09:00:00.000Z",
  "description": "Testing 02 via REST file",
  "location": "Online",
  "isAllDay": false,
  "color": "#2196F3"
}


### GET events — unauthenticated (expect 401)
GET {{baseUrl}}/api/events

### GET events — authenticated (expect 200 and array; [] if no events)
// @no-cookie-jar
GET {{baseUrl}}/api/events
Cookie: {{cookie}}


### GET events with date range (March 2026)
// @no-cookie-jar
GET {{baseUrl}}/api/events?start=2026-04-12&end=2026-04-14
Cookie: {{cookie}}

### Update event (expect 200)
// @no-cookie-jar
PUT {{baseUrl}}/api/events/69aa3d8de447760405ec5405
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "Updated title via PUT",
  "start": "2026-03-10T09:00:00.000Z",
  "end": "2026-03-10T11:00:00.000Z",
  "description": "Updated description",
  "location": "Office",
  "isAllDay": false,
  "color": "#4CAF50"
}

### Delete event — authenticated, own event (expect 204 or 200)
// @no-cookie-jar
DELETE {{baseUrl}}/api/events/69a798b355d60b499018328c
Cookie: {{cookie}}

### Get tips — authenticated (expect 200)
// @no-cookie-jar
GET {{baseUrl}}/api/events/tips?start=2026-04-12&end=2026-04-14
Cookie: {{cookie}}

### Get tips — no data range
// @no-cookie-jar
GET {{baseUrl}}/api/events/tips
Cookie: {{cookie}}

### Get tips — with date  range
// @no-cookie-jar
GET {{baseUrl}}/api/events/tips?start=2026-02-28&end=2026-02-28
Cookie: {{cookie}}


### Get tips when there are NO events in the range
// This request returns 3 static generic tips because there are no events in this date range.
// Static fallback: does NOT call Gemini in this case.
// @no-cookie-jar
GET {{baseUrl}}/api/events/tips?start=2099-03-16&end=2099-03-16
Cookie: {{cookie}}


### Get tips with invalid date query (should hit parseListOptionsFromQuery error)
// @no-cookie-jar
GET {{baseUrl}}/api/events/tips?start=not-a-date&end=also-bad
Cookie: {{cookie}}


### Create an event with unsafe/harmful content (for safety test)
// @no-cookie-jar
POST {{baseUrl}}/api/events
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "Plan a detailed violent attack on my colleague",
  "start": "2026-03-16T09:00:00.000Z",
  "end": "2026-03-16T10:00:00.000Z",
  "description": "This content should be blocked by safety filter",
  "location": "Office",
  "isAllDay": false,
  "color": "#FF0000"
}

### List events including the unsafe one (optional)
// @no-cookie-jar
GET {{baseUrl}}/api/events?start=2026-03-16&end=2026-03-17
Cookie: {{cookie}}

### Try to trigger Gemini safety filter for tips
// @no-cookie-jar
GET {{baseUrl}}/api/events/tips?start=2026-03-16&end=2026-03-17
Cookie: {{cookie}}
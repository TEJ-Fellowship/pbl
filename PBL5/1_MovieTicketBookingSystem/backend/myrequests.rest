### Seat-Only Redis Booking System - Load Testing
### Simple approach: Just seat_ids, no user/movie/showtime needed

@baseUrl = http://localhost:3001
@apiUrl = {{baseUrl}}/api

### ============================================
### VARIABLES - Fill these after creating booking
### ============================================
@booking_id = d74d4241-e2b8-457c-bb49-49f1431bf9b9
@payment_id = 31d335c4-c4eb-4a72-9b05-e717e1f5e770

### ============================================
### STEP 1: CREATE BOOKING
### ============================================
### Seat IDs: Use seat1, seat2, seat3, ..., seat1000
### Any number from 1 to 1000 works

POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat113", "seat223", "seat334"]
}
### Expected: 201 Created
### Response includes: id, seat_ids, status: "pending", total_amount
### Copy "id" from response → paste in @booking_id above

### ============================================
### STEP 2: GET BOOKING
### ============================================
GET {{apiUrl}}/bookings/{{booking_id}}
### Expected: 200 OK
### Response: Complete booking details

### ============================================
### STEP 3: PROCESS PAYMENT
### ============================================
### Amount should match total_amount from booking (100 per seat)
### For 3 seats = 300

POST {{apiUrl}}/payments/process
Content-Type: application/json

{
  "booking_id": "{{booking_id}}",
  "amount": 300,
  "payment_method": "credit_card"
}
### Expected: 200 OK
### Response includes: payment_id, status: "success", receipt
### Copy "payment_id" from response → paste in @payment_id above

### ============================================
### STEP 4: VERIFY BOOKING IS CONFIRMED
### ============================================
GET {{apiUrl}}/bookings/{{booking_id}}
### Expected: status = "confirmed"

### ============================================
### STEP 5: GET PAYMENT DETAILS
### ============================================
GET {{apiUrl}}/payments/booking/{{booking_id}}
### Expected: Payment details with receipt

### ============================================
### STEP 6: CANCEL BOOKING (Optional - Only pending)
### ============================================
### Note: Can only cancel pending bookings (before payment)

DELETE {{apiUrl}}/bookings/{{booking_id}}
### Expected: 200 OK
### Response: Booking cancelled, seats released

### ============================================
### STEP 7: GET ALL BOOKINGS (For Testing)
### ============================================
GET {{apiUrl}}/bookings
### Expected: List of all bookings in Redis

### ============================================
### TEST: CONCURRENT BOOKINGS (Load Testing)
### ============================================
### Run these TWO requests at the SAME TIME
### Expected: One succeeds (201), one fails (409)

### Request 1
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat10"]
}

### Request 2 (run immediately after Request 1)
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat10"]
}
### Expected: One gets 201 Created, other gets 409 Conflict (seat busy)

### ============================================
### TEST: BOOKING FLOW WITH DIFFERENT SEATS
### ============================================

### Create booking with different seats
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat50", "seat51", "seat52"]
}

### Pay for it
POST {{apiUrl}}/payments/process
Content-Type: application/json

{
  "booking_id": "PASTE_BOOKING_ID_HERE",
  "amount": 300,
  "payment_method": "credit_card"
}

### Try to book same seats again (should fail)
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat50", "seat51"]
}
### Expected: 409 Conflict - "Some seats are not available"

### ============================================
### TEST: CANCELLATION FLOW
### ============================================

### Step 1: Create booking
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat100"]
}

### Step 2: Cancel booking
DELETE {{apiUrl}}/bookings/PASTE_BOOKING_ID_HERE
### Expected: 200 OK - Booking cancelled

### Step 3: Book same seat again (should work)
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["seat100"]
}
### Expected: 201 Created - Seat available again

### ============================================
### ERROR TESTING
### ============================================

### Test: Empty seat_ids
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": []
}
### Expected: 400 Bad Request

### Test: Invalid seat (not in available_seats)
POST {{apiUrl}}/bookings
Content-Type: application/json

{
  "seat_ids": ["invalid_seat"]
}
### Expected: 409 Conflict - "Some seats are not available"

### Test: Payment with wrong amount
POST {{apiUrl}}/payments/process
Content-Type: application/json

{
  "booking_id": "{{booking_id}}",
  "amount": 999,
  "payment_method": "credit_card"
}
### Expected: 400 Bad Request - "Payment amount does not match booking total"

### Test: Payment for non-existent booking
POST {{apiUrl}}/payments/process
Content-Type: application/json

{
  "booking_id": "00000000-0000-0000-0000-000000000000",
  "amount": 300,
  "payment_method": "credit_card"
}
### Expected: 404 Not Found - "Booking not found"

### Test: Double payment (pay same booking twice)
### Step 1: First payment
POST {{apiUrl}}/payments/process
Content-Type: application/json

{
  "booking_id": "{{booking_id}}",
  "amount": 300,
  "payment_method": "credit_card"
}

### Step 2: Try to pay again
POST {{apiUrl}}/payments/process
Content-Type: application/json

{
  "booking_id": "{{booking_id}}",
  "amount": 300,
  "payment_method": "credit_card"
}
### Expected: 400 Bad Request - "Booking is already confirmed"

